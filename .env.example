# PAGE MANAGER

# ============================================================
# PRODUCTION FIREBASE / VERCEL
# Tạo 1 Firebase project bình thường rồi dán Web App config vào đây.
# Khi VITE_FIREBASE_PROJECT_ID có giá trị, app sẽ ưu tiên toàn bộ ENV này
# thay vì firebase-applet-config.json do AI Studio tạo.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Để trống = database mặc định. Chỉ điền khi bạn cố ý dùng named database.
VITE_FIRESTORE_DATABASE_ID=

# Server-side Firebase REST/Admin config.
# Nên điền cùng project với VITE_* phía trên trên Vercel.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Với Firebase project mới bình thường, đặt chính xác: (default)
FIRESTORE_DATABASE_ID=(default)

# Nếu backend cần Firebase Admin thật, dùng 1 trong 2 cách:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# hoặc:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Meta App ID / App Secret can be entered inside Cài đặt & Facebook.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
APP_URL=

# AI SHOP MANAGER - GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Messenger automation chạy nền 24/7
AUTOMATION_CRON_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
AUTOMATION_ENCRYPTION_KEY=
AUTOMATION_INTERNAL_LOOP=false
AUTOMATION_INTERNAL_LOOP_MS=120000
META_WEBHOOK_REQUIRE_SIGNATURE=true
