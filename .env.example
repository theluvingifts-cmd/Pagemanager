# ==========================================
# PAGE MANAGER - ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Configuration
# Required for real database, auth, and media storage
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook Developer App Credentials
# Required for Facebook Login OAuth and Meta Graph API publishing
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v19.0

# Application Host URL (AI Studio Cloud Run URL or local http://localhost:3000)
APP_URL=

# Token Encryption Secret (32-character key for AES-256-GCM token encryption)
TOKEN_ENCRYPTION_KEY=

# Gemini API Key (managed by Google AI Studio)
GEMINI_API_KEY=
