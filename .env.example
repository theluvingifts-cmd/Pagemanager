# ============================================================
# PROJECT B - FIREBASE STORAGE ONLY
# Page Manager keeps Auth/Firestore in project A, while media is uploaded here.
# Use EITHER STORAGE_FIREBASE_SERVICE_ACCOUNT OR the 3 split credential vars.
# ============================================================
STORAGE_FIREBASE_PROJECT_ID=the-luvin
STORAGE_FIREBASE_BUCKET=the-luvin.firebasestorage.app
STORAGE_FIREBASE_SERVICE_ACCOUNT=
STORAGE_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@the-luvin.iam.gserviceaccount.com
STORAGE_FIREBASE_PRIVATE_KEY=

# Meta App ID / App Secret can be entered inside Cài đặt & Facebook.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
APP_URL=

# AI SHOP MANAGER - GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Messenger automation chạy nền 24/7
AUTOMATION_CRON_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
AUTOMATION_ENCRYPTION_KEY=
AUTOMATION_INTERNAL_LOOP=false
AUTOMATION_INTERNAL_LOOP_MS=120000
META_WEBHOOK_REQUIRE_SIGNATURE=true
