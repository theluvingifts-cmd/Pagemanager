# PAGE MANAGER
# Firebase client config normally comes from firebase-applet-config.json in AI Studio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Meta App ID / App Secret can be entered inside Cài đặt & Facebook.
# These environment variables remain optional fallback values.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
APP_URL=

# AI SHOP MANAGER - GEMINI
# Google AI Studio Build normally provisions GEMINI_API_KEY automatically as a server-side secret.
# If running outside AI Studio, set it in your hosting environment.
GEMINI_API_KEY=
# Optional. Stable production default used by this project.
GEMINI_MODEL=gemini-3.8-flash

# Messenger automation chạy nền 24/7
# Dùng để bảo vệ endpoint Cloud Scheduler. Tự tạo chuỗi ngẫu nhiên dài.
AUTOMATION_CRON_SECRET=
# Token xác minh webhook. Tự đặt một chuỗi riêng và nhập y hệt trong Meta Developer Webhooks.
META_WEBHOOK_VERIFY_TOKEN=
# Có thể bỏ trống để dùng TOKEN_ENCRYPTION_KEY hiện tại.
AUTOMATION_ENCRYPTION_KEY=
# Chỉ dùng local/always-on server. Cloud Run vẫn cần Cloud Scheduler để chạy thật 24/7.
AUTOMATION_INTERNAL_LOOP=false
AUTOMATION_INTERNAL_LOOP_MS=120000
# Mặc định bắt buộc kiểm tra X-Hub-Signature-256 từ Meta.
META_WEBHOOK_REQUIRE_SIGNATURE=true
